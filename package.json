    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "react-server-dom-webpack": "^19.2.8",
    "server-only": "^0.0.1",
    "vinext": "^1.0.0-beta.9",
    "zod": "^3.25.76"
